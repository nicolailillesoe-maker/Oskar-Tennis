; StreakTennis · anmodning om Apple Distribution-certifikat (laves på Windows med certreq — ingen Mac)
; Nøglen bliver liggende i DIN Windows-brugers certifikatlager og forlader kun pc'en som GitHub-hemmelighed.
[NewRequest]
Subject = "CN=StreakTennis Distribution, O=SportsAInalytics, C=DK"
KeyLength = 2048
KeyAlgorithm = RSA
HashAlgorithm = SHA256
Exportable = TRUE
MachineKeySet = FALSE
RequestType = PKCS10
KeyUsage = 0xA0
